# raphael (SM8150) kernel defconfig for UniXNU
# arm64 target (iPadOS 17.7.11)

# Architecture
CONFIG_ARM64=y
CONFIG_ARM64_PAGE_SHIFT=12
CONFIG_ARM64_4K_PAGES=y

# SoC
CONFIG_SOC_SM8150=y
CONFIG_SOC_SM8150_UFS=y

# Drivers
CONFIG_UFS=y
CONFIG_DISPLAY=y
CONFIG_FRAMEBUFFER=y

# Boot
CONFIG_BOOT_PROGRESS=y
